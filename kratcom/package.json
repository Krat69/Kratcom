{
  "name": "kratcom",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "sync": "npm run build && cap sync",
    "android": "npm run sync && cap open android",
    "ios": "npm run sync && cap open ios",
    "electron:dev": "npm run build && electron electron/main.mjs",
    "electron:build": "npm run build && electron-builder --linux --config electron-builder.json"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/file-transfer": "^2.0.4",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/share": "^8.0.1",
    "@wllama/wllama": "^3.5.1",
    "clsx": "^2.1.1",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.0",
    "vitest": "^4.1.10"
  },
  "description": "IA local con memoria persistente en Markdown, para Android, iPhone y Linux",
  "main": "electron/main.mjs",
  "optionalDependencies": {
    "node-llama-cpp": "^3.19.1"
  }
}
